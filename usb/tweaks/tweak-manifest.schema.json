{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMU launcher tweak manifest",
  "description": "Ready-to-run launcher contract v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "type",
    "group",
    "firmware",
    "entrypoint",
    "actions",
    "status_scope",
    "reboot_required",
    "contract_version",
    "requires",
    "conflicts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[ -~]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[ -~]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "enum": [
        "patch",
        "service",
        "command",
        "files"
      ]
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "firmware": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "entrypoint": {
      "const": "run.sh"
    },
    "actions": {
      "oneOf": [
        {
          "const": [
            "install",
            "uninstall",
            "status"
          ]
        },
        {
          "const": [
            "run",
            "status"
          ]
        }
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_./-]+$"
    },
    "original_md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "lock_group": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status_scope": {
      "enum": [
        "target-patch",
        "configuration",
        "payload",
        "service-health"
      ]
    },
    "reboot_required": {
      "type": "boolean"
    },
    "contract_version": {
      "const": 1
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  }
}
